# Copy this file to .env and fill in real values. Never commit .env.
# The local container DB already has working defaults in appsettings.json,
# so you only need to override what differs on your machine.

# Local container DB (optional override)
ConnectionStrings__LocalConnection=Host=localhost;Port=5433;Database=findatime;Username=findatime;Password=findatime

# Staging (Neon). Required for the `staging` launch profile.
# The same key is set as a Render env var in deployment; no .env is deployed.
ConnectionStrings__StagingConnection=