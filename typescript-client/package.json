{
  "name": "@arompr/findatime-typescript-client",
  "version": "0.0.0",
  "description": "TypeScript types and fetch client for the Findatime REST API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "gen": "openapi-ts -f openapi-ts.config.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run gen && npm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "^5.6.0"
  }
}
